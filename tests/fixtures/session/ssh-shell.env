# Synthetic: SSH login without X forwarding. The SSH values are documentation addresses.
XDG_SESSION_TYPE=tty
XDG_SESSION_ID=7
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
SSH_CONNECTION=192.0.2.10 51514 192.0.2.20 22
SSH_CLIENT=192.0.2.10 51514 22
SSH_TTY=/dev/pts/3
